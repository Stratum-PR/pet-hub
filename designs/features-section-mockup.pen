{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "name": "Splash features — Pencil mockup",
      "width": 1200,
      "height": 820,
      "layout": "vertical",
      "gap": 20,
      "padding": 28,
      "fill": "#F1F5F9",
      "children": [
        {
          "type": "text",
          "name": "Note",
          "content": "Asset reference only (./pencil-assets/). Live splash uses pills + one detail card; mascot overlays the screenshot with no circle frame.",
